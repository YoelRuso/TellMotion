{
  "name": "tellmotion-repository",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "TellMotion: turn an idea into a polished 2D explainer animation (skill, themes, site).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:smoke": "node scripts/smoke.mjs",
    "validate": "node skills/tellmotion/tools/validate.mjs",
    "doctor": "node skills/tellmotion/tools/doctor.mjs",
    "catalog": "node skills/tellmotion/tools/build-catalog.mjs site/public --no-gallery",
    "assets": "node scripts/readme-assets.mjs",
    "sheets": "node scripts/recipe-sheets.mjs",
    "sheets:packs": "node scripts/pack-sheets.mjs"
  }
}
