---
import {GITHUB_URL, NAME} from '../config';
---
<header class="nav" id="nav">
  <div class="wrap">
    <a class="logo" href="#top" aria-label={`${NAME} home`}>
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7c5cff" /><stop offset="1" stop-color="#22d3ee" /></linearGradient></defs>
        <rect width="64" height="64" rx="16" fill="url(#lg)" />
        <path d="M26 19l20 13-20 13z" fill="#06060b" />
        <path d="M12 24h8M10 32h10M12 40h8" stroke="#06060b" stroke-width="3" stroke-linecap="round" opacity=".55" />
      </svg>
      {NAME}
    </a>
    <nav aria-label="Main">
      <ul>
        <li><a href="#how">How it works</a></li>
        <li><a href="#packs">Packs</a></li>
        <li><a href="#themes">Themes</a></li>
        <li><a href="#examples">Examples</a></li>
        <li><a href="#install">Install</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </nav>
    <a class="gh" href={GITHUB_URL} target="_blank" rel="noopener">
