---
<section id="packs">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Component packs</span>
      <h2>Ready-made pieces for <span class="grad">any topic</span>.</h2>
      <p>Pick the packs your story needs. Every piece is themed automatically, so it looks right in any of the styles.</p>
    </div>
    <div class="bento">
      {packs.map((p, i) => (
        <article class={`pack reveal d${i % 4}${p.wide ? ' wide' : ''}`}>
          <Fragment set:html={p.svg} />
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <code>{p.code}</code>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // soft spotlight that follows the pointer on each pack card
  document.querySelectorAll<HTMLElement>('.pack').forEach(el => {
    el.addEventListener('pointermove', e => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
