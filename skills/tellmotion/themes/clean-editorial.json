{
  "id": "clean-editorial",
  "name": "Clean Editorial",
  "family": "editorial",
  "moods": [
    "clean",
    "calm",
    "professional"
  ],
  "description": "Light, airy editorial look: soft green-gray background, white rounded cards, hairline borders and gentle shadows.",
